teration 800","note":"","policy":"runs/r2/net_800.npy","n":1000,"score":0.754,"ci":[0.7264,0.7797],"big_money":0.9275,"smithy_bm":0.7925,"witch_bm":0.6725,"secs":100,"vs_az":0.617,"vs_az_ci":[0.5865,0.6466],"vs_az_n":1000},"goal_r2_iter825":{"t":"2026-11-18 02:04:26","label":"r2 iteration 825","note":"","policy":"runs/r2/net_825.npy","n":1000,"score":0.7615,"ci":[0.7341,0.7869],"big_money":0.92,"smithy_bm":0.7925,"witch_bm":0.655,"secs":1},"goal_r2_iter850":{"t":"2026-11-18 02:16:04","label":"r2 iteration 850","note":"","policy":"runs/r2/net_850.npy","n":1000,"score":0.755,"ci":[0.7274,0.7806],"big_money":0.93,"smithy_bm":0.8,"witch_bm":0.6925,"secs":99,"vs_az":0.6345,"vs_az_ci":[0.6042,0.6638],"vs_az_n":1000},"goal_r2_iter875":{"t":"2026-11-18 02:25:29","label":"r2 iteration 875","note":"","policy":"runs/r2/net_875.npy","n":1000,"score":0.769,"ci":[0.7419,0.7941],"big_money":0.8925,"smithy_bm":0.7975,"witch_bm":0.7,"secs":1},"goal_r2_iter900":{"t":"2026-11-18 02:36:57","label":"r2 iteration 900","note":"","policy":"runs/r2/net_900.npy","n":1000,"score":0.7635,"ci":[0.7362,0.7888],"big_money":0.9225,"smithy_bm":0.845,"witch_bm":0.675,"secs":100,"vs_az":0.623,"vs_az_ci":[0.5925,0.6525],"vs_az_n":1000}},"timeline":{"r1":[],"r2":[]},"decisions":[{"t":"2026-11-17 22:03:09","kind":"decision","title":"Release: models/rl_r2_200","text":"r2's net 200, confirmed on 4,000 new games, saved as models/rl_r2_200.npy (+ .pt). Chosen at a goal-check iteration, before the confirmation, so the confirmation numbers are not selected.","rejected":"a later or best-evaluation checkpoint (selection by evaluation would flatter it)"},{"t":"2026-11-17 20:22:13","kind":"decision","title":"Run r2: az-v1's agent joins the league","text":"From r1's newest net. League: 30% GA base, 15% bots, 15% past snapshots, 15% az-v1's best net without search (its buys, GA actions; fast), 5% az-v1's best agent with 400-simulation search (~0.5 s a game), 20% itself. Head-to-head checks every 50 iterations.","rejected":"keeping r1's league (flat at ~68% / ~49% for 100 iterations)"},{"t":"2026-11-17 20:03:09","kind":"decision","title":"Method: one network for every decision, behaviour cloning then PPO with a league","text":"Third method, deliberately unlike the GA (evolved rules) and az-v1 (tree search over buys): a 298-256-256-34 MLP answers all ~22 kinds of decision, imitates the GA genome first (1.08 M decisions, 98.5% agreement), then improves by PPO (clip 0.2, GAE lambda 0.95, entropy 0.01) against 40% GA base, 15% bots, 15% past snapshots, 30% itself. Runs in C inside the engine: 3 ms per game, so 3,000 games per ~10 s iteration.","rejected":"more search (az-v1 showed it saturates); evolution again; a value-only method (DQN) \u2014 PPO is the standard, stable choice for a large discrete action space with masking"}],"reports":[],"strip":{"alive":true,"run":"r2","stage":null,"goal_text":"70.0%","stages_text":"0 of ? stages passed","best_text":"79.9%","verified_text":"76.9%","verified_sub":"r2 iteration 875, n=1000"}}