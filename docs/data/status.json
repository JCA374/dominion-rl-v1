5,0.7835],"big_money":0.9325,"smithy_bm":0.8025,"witch_bm":0.6775,"secs":104,"vs_az":0.6185,"vs_az_ci":[0.588,0.6481],"vs_az_n":1000},"goal_r2_iter975":{"t":"2026-11-18 03:08:39","label":"r2 iteration 975","note":"","policy":"runs/r2/net_975.npy","n":1000,"score":0.7545,"ci":[0.7269,0.7802],"big_money":0.9175,"smithy_bm":0.8025,"witch_bm":0.685,"secs":1}},"timeline":{"r1":[],"r2":[]},"decisions":[{"t":"2026-11-17 22:03:09","kind":"decision","title":"Release: models/rl_r2_200","text":"r2's net 200, confirmed on 4,000 new games, saved as models/rl_r2_200.npy (+ .pt). Chosen at a goal-check iteration, before the confirmation, so the confirmation numbers are not selected.","rejected":"a later or best-evaluation checkpoint (selection by evaluation would flatter it)"},{"t":"2026-11-17 20:22:13","kind":"decision","title":"Run r2: az-v1's agent joins the league","text":"From r1's newest net. League: 30% GA base, 15% bots, 15% past snapshots, 15% az-v1's best net without search (its buys, GA actions; fast), 5% az-v1's best agent with 400-simulation search (~0.5 s a game), 20% itself. Head-to-head checks every 50 iterations.","rejected":"keeping r1's league (flat at ~68% / ~49% for 100 iterations)"},{"t":"2026-11-17 20:03:09","kind":"decision","title":"Method: one network for every decision, behaviour cloning then PPO with a league","text":"Third method, deliberately unlike the GA (evolved rules) and az-v1 (tree search over buys): a 298-256-256-34 MLP answers all ~22 kinds of decision, imitates the GA genome first (1.08 M decisions, 98.5% agreement), then improves by PPO (clip 0.2, GAE lambda 0.95, entropy 0.01) against 40% GA base, 15% bots, 15% past snapshots, 30% itself. Runs in C inside the engine: 3 ms per game, so 3,000 games per ~10 s iteration.","rejected":"more search (az-v1 showed it saturates); evolution again; a value-only method (DQN) \u2014 PPO is the standard, stable choice for a large discrete action space with masking"}],"reports":[],"strip":{"alive":false,"run":"r2","stage":null,"goal_text":"70.0%","stages_text":"0 of ? stages passed","best_text":"85.9%","verified_text":"83.0%","verified_sub":"r2 iteration 2050, n=1000"}}